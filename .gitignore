.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# --- Signing / secrets (never commit) ---
*.jks
*.keystore
*.p12
*.pem
*.key
store.pass
key.pass
keystore.properties
signing.properties
secrets.properties
.env
.env.local
!.env.example

# --- fastlane generated output ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# --- Python helpers in scripts/ ---
__pycache__/
*.py[cod]
.pytest_cache/

# Design-reference drops at the repo root (screenshots, mockups, sample books).
# Real assets live in module res/ dirs; these must never be committed.
/*.png
/*.jpg
/*.jpeg
/*.avif
/*.webp
/*.gif
/*.epub
/*.pdf
